# ============================================================
# Reservas CRM — variables de entorno
# Copia este archivo a `.env` y reemplaza cada REEMPLAZA_...
# En producción estas variables van en tu plataforma de hosting
# (Coolify / docker compose), no solo en el archivo.
# ============================================================

# --- Aplicación ---------------------------------------------
# URL pública de la instancia (con https en producción).
# De ella se construye la URL del webhook de WhatsApp.
APP_BASE_URL=REEMPLAZA_https://crm.tudominio.com

# Solo Ruta B (docker compose): dominio para el HTTPS automático de Caddy.
DOMAIN=REEMPLAZA_crm.tudominio.com

# --- Reservas Core migration --------------------------------
# legacy keeps the current CRM authority; shadow compares safe reads; core
# switches selected routes only after the auth/session bridge is enabled.
# CORE_API_URL=https://core-staging.reservas.com.py
# CORE_API_MODE=legacy
# CRM_CORE_BRIDGE_SECRET=replace-with-the-same-secret-in-the-core-runtime

# --- Base de datos ------------------------------------------
# Ruta B usa el servicio interno `postgres` del compose.
# Genera la contraseña con:  openssl rand -hex 24
POSTGRES_PASSWORD=REEMPLAZA_password_de_postgres
DATABASE_URL=postgresql://postgres:REEMPLAZA_password_de_postgres@postgres:5432/reservas_crm

# --- Secretos de la aplicación ------------------------------
# Firma de sesiones. Genera con:  openssl rand -base64 32
BETTER_AUTH_SECRET=REEMPLAZA_secreto_de_sesiones

# Cifrado en reposo del token de WhatsApp (AES-256-GCM).
# DEBE ser exactamente 32 bytes en base64 (44 caracteres).
# Genera con:  openssl rand -base64 32
ENCRYPTION_KEY=REEMPLAZA_clave_de_cifrado_base64

# --- WhatsApp (webhook) -------------------------------------
# Token de verificación del webhook. Es también el segmento secreto
# de la URL del webhook: /api/webhooks/wa/<este_valor>
# Genera con:  openssl rand -hex 32
META_WEBHOOK_VERIFY_TOKEN=REEMPLAZA_token_de_verificacion

# OPCIONAL (recomendado en modo directo): App Secret de tu app de Meta
# para validar la firma de cada webhook (x-hub-signature-256).
# Se obtiene en developers.facebook.com → tu app → Configuración → Básica.
# En modo agencia normalmente se deja vacío (la URL secreta protege el webhook).
# META_APP_SECRET=

# --- Instagram API (same Meta app may be used for WhatsApp and Instagram) ---
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_WEBHOOK_VERIFY_TOKEN=REEMPLAZA_token_instagram
# INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com

# --- Visibilidad interna de secretos en Ajustes -------------
# Correos internos autorizados a revelar/copiar IDs, tokens y URLs sensibles
# en Ajustes > WhatsApp e Instagram. Déjalo vacío en instancias de clientes.
# RESERVAS_SECRET_REVEAL_EMAILS=owner@example.com

# --- Provisioning interno reservas-platform -> CRM ----------
# Secreto HMAC usado por el endpoint interno de provisioning de WhatsApp.
# Genera con:  openssl rand -base64 32
# CRM_PROVISIONING_SECRET=
# Secreto separado para operaciones destructivas CRM -> platform (desconectar).
# PLATFORM_OPERATOR_SECRET=
# Solo para smoke local/MSI con tokens sintéticos. No usar en producción.
# CRM_PROVISIONING_ACCEPT_RAW_TOKEN_SMOKE_ONLY=true
# Plataforma central usada por el botón de desconexión/re-onboarding.
# PLATFORM_ORIGIN=https://platform.reservas.com.py
# ID de instalación en reservas-platform para esta instancia de CRM.
# PLATFORM_INSTALLATION_ID=

# --- Google Calendar (Basic plan, optional) -----------------
# OAuth web application credentials from Google Cloud. The client secret stays
# only on the server and is never shown to CRM users.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# Must exactly match the OAuth client's authorized redirect URI.
# GOOGLE_CALENDAR_REDIRECT_URI=https://crm.tudominio.com/api/calendar/oauth/callback

# Solo habilitar si el CRM está detrás de un proxy inverso confiable que
# sobrescribe x-forwarded-for; Better Auth lo usa para rate limiting de autenticación.
# TRUST_PROXY_HEADERS=true

# Versión de la Graph API (déjala así salvo que sepas por qué cambiarla).
META_GRAPH_API_VERSION=v25.0

# --- Inteligencia artificial (opcional) ---------------------
# Sin token, el CRM funciona completo excepto Agente y Laboratorio.
# Crea tu key en https://openrouter.ai → Keys (o usa cualquier proveedor
# compatible con la API de OpenRouter cambiando OPENROUTER_BASE_URL).
# OPENROUTER_API_TOKEN=
# OPENROUTER_BASE_URL=https://openrouter.ai/api
# Modelo principal del agente. Para bajo costo, usar el aprobado por defecto.
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Modelo del juez del Laboratorio (si se omite, usa el principal)
# OPENROUTER_JUDGE_MODEL=
# Modelo barato aprobado para respuestas normales.
# AI_APPROVED_LOW_COST_MODEL=deepseek/deepseek-v4-flash
# Límite de salida por llamada normal del agente.
# AI_MAX_OUTPUT_TOKENS=500
# Propiedad de la key: managed_shared, managed_customer_isolated, self_hosted_owner_key.
# AI_PROVIDER_KEY_OWNERSHIP=self_hosted_owner_key
# Caps operativos opcionales. Si AI_DAILY_REPLY_CAP=0, el agente queda bloqueado.
# AI_DAILY_REPLY_CAP=
# AI_DAILY_TOKEN_CAP=
# Los probes facturables quedan desactivados salvo que se habiliten explícitamente.
# AI_BILLABLE_PROBE_ENABLED=false
# Kill switch operacional del agente.
# AI_EMERGENCY_DISABLE=false

# --- Operación (opcional) -----------------------------------
# Reabrir el registro público después de la primera organización.
# ALLOW_SIGNUP=true

# Milisegundos de agrupación de mensajes antes del turno del agente (default 6000).
# AGENT_COALESCE_MS=6000
